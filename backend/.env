# Redis (opzionale, per rate limiting e JWT blacklist)
REDIS_URL=redis://:f436958355c2375ee687c7d6ebe79c13b1fc978dd02f9ef5@localhost:6379/0

# Eventlet (usa DNS nativo, non green DNS)
EVENTLET_NO_GREENDNS=yes

# Server
PORT=5000
MODEL_REFRESH_TTL=3600
FLASK_ENV=production

# Ollama (modelli locali)
OLLAMA_BASE=http://localhost:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_THREAD=6
OLLAMA_KEEP_ALIVE=30m

# Forza il modello locale abliterated come PRIMA scelta per tutte le chat
# (prima delle preferenze utente e della catena cloud). 1=on, 0=off
FORCE_LOCAL_FIRST=0

# Ensemble Parallelo: invia lo stesso prompt a Cerebras + Groq in parallelo
# Il primo che risponde vince. 1=on, 0=off
ENSEMBLE_ENABLED=1

# Modelli dell'ensemble (JSON array di [provider_id, model_id])
# Default: Cerebras gpt-oss-120b + Groq llama-3.3-70b-versatile
ENSEMBLE_MODELS='[["cerebras", "gpt-oss-120b"], ["groq", "llama-3.3-70b-versatile"]]'

# Provider principale per le chat
# groq  → Groq 70B (italiano perfetto, gratis, 1000 req/giorno)
# local → modello locale Qwen 3B (gratis, offline, italiano scarso)
# auto  → catena normale (locale prima, poi cloud)
CHAT_PROVIDER=groq

# Guardiano RAM: modelli pesanti (7B+) saltati se RAM libera < required + questo margine
# Default 1.5 GB. Abbassa a 0.5 se hai server grande e vuoi forzare l'uso del 7B
RAM_GUARDIAN_MIN_FREE_GB=1.5

# llama.cpp (server locale alternativo)
LLAMACPP_MODEL=local-model
LLAMACPP_TEMP=0.8
LLAMACPP_MAX_TOKENS=512

# Sentry (error monitoring)
SENTRY_DSN=https://86507870435aaa852bd38c30de4d59f6@o4509918060150784.ingest.de.sentry.io/4511693193019472
MASTER_KEY=pl
LLAMACPP_API_KEY=.
