# API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
GITHUB_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Sign-In (obbligatorio: Client ID da Google Cloud Console)
GOOGLE_CLIENT_ID=

# JWT — genera con: openssl rand -hex 64
JWT_SECRET=changeme_in_production_generate_random_64_hex

# Redis (opzionale, per rate limiting e JWT blacklist)
REDIS_URL=redis://localhost:6379/0

# Server
PORT=5000
MODEL_REFRESH_TTL=3600
FLASK_ENV=production

# ── Ollama (modelli locali) ──
# URL del server Ollama (default: http://localhost:11434)
OLLAMA_BASE=http://localhost:11434
# Contesto in token (4096 bilancia memoria vs qualità conversazione lunga)
OLLAMA_NUM_CTX=4096
# Token massimi generati per risposta (512 = roleplay completo senza tagli)
OLLAMA_NUM_PREDICT=512
# Thread CPU (default: 6, abbassa se server.other domina CPU)
OLLAMA_NUM_THREAD=6
# Mantieni modello in RAM dopo inferenza (es: 30m, 2h, 0 = scarica subito)
OLLAMA_KEEP_ALIVE=30m

# Forza il modello locale abliterated come PRIMA scelta per tutte le chat
# (prima delle preferenze utente e della catena cloud). 1=on, 0=off
FORCE_LOCAL_FIRST=1

# Guardiano RAM: modelli 7B+ saltati se RAM libera < required + questo margine.
# Abbassa a 0.5 per attivare il 7B quando potenzi il server (16 GB+ RAM).
RAM_GUARDIAN_MIN_FREE_GB=1.5

# ── llama.cpp (server locale alternativo su porta 8080) ──
# Model name da inviare al server llama.cpp (di default qualunque nome è accettato)
LLAMACPP_MODEL=local-model
LLAMACPP_TEMP=0.8
LLAMACPP_MAX_TOKENS=512
