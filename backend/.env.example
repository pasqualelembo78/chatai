# API Keys
DATABASE_URL=postgresql://chatai:password@localhost:5432/chatai
GEMINI_API_KEY=your_gemini_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
MISTRAL_API_KEY=your_mistral_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here
GITHUB_TOKEN=your_github_token_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PEXELS_API_KEY=your_pexels_key_here

# Multiple Keys (separate with commas for rotation)
GROQ_API_KEYS=key1,key2,key3
PEXELS_API_KEYS=key1,key2

# Nuovi Provider
TOGETHER_API_KEY=
CEREBRAS_API_KEY=your_cerebras_key_here
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
DEEPINFRA_API_KEY=
FIREWORKS_API_KEY=
SAMBANOVA_API_KEY=your_sambanova_key_here
NEBIUS_API_KEY=
NOVITA_API_KEY=
INFERENCE_API_KEY=
LLAMACPP_API_KEY=

# Google Sign-In
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# JWT
JWT_SECRET=generate_random_64_hex_chars

# Redis
REDIS_URL=redis://:password@localhost:6379/0

# Eventlet
EVENTLET_NO_GREENDNS=yes

# Server
PORT=5000
MODEL_REFRESH_TTL=3600
FLASK_ENV=production

# Ollama
OLLAMA_BASE=http://localhost:11434
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_NUM_THREAD=6
OLLAMA_KEEP_ALIVE=30m

# Feature Flags
FORCE_LOCAL_FIRST=0
ENSEMBLE_ENABLED=1
ENSEMBLE_MODELS='[["cerebras", "gpt-oss-120b"], ["groq", "llama-3.3-70b-versatile"]]'
CHAT_PROVIDER=groq
RAM_GUARDIAN_MIN_FREE_GB=1.5

# llama.cpp
LLAMACPP_MODEL=local-model
LLAMACPP_TEMP=0.8
LLAMACPP_MAX_TOKENS=512

# Sentry
SENTRY_DSN=
MASTER_KEY=your_master_key_here

# Daily free-message limit per user (MevaCoins economy)
# Normal users can send at most DAILY_FREE_MESSAGE_LIMIT AI chat messages per UTC day.
# Admins/moderators are unlimited. Users can lift the limit permanently by spending
# DAILY_UNLOCK_MVC_COST MevaCoins (endpoint POST /user/messages/unlock).
DAILY_FREE_MESSAGE_LIMIT=50
DAILY_UNLOCK_MVC_COST=100
