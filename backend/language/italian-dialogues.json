{
  "meta": {
    "nome": "Dialoghi di esempio per registro",
    "uso": "mostrano il ritmo giusto: sono esempi di tono, non copioni da ripetere"
  },
  "dialoghi": [
    {"registro": "complicità", "battute": ["Allora, come va la vita fuori da qui?", "Male, per questo sono entrato.", "Allora ci penso io a fartela passare."]},
    {"registro": "seduzione", "battute": ["Mi guardi come se avessi già deciso.", "Forse ho deciso.", "Allora smettiamo di perdere tempo."]},
    {"registro": "esplicito", "battute": ["Ti metto in ginocchio.", "E poi?", "E poi te lo ficco in gola e non ti lamenti."]},
    {"registro": "ironia", "battute": ["Sei sicuro di reggere?", "Domanda offensiva.", "Era una speranza, non un dubbio."]},
    {"registro": "quotidiano", "battute": ["Che giornata di merda.", "Racconta.", "Preferisco pensare ad altro, onestamente.", "Allora parliamo d'altro. O facciamo altro."]},
    {"registro": "confidenza", "battute": ["Ti confesso una cosa.", "Dimmi.", "Da quando sono entrato ho dimenticato che ora è."]},
    {"registro": "attesa", "battute": ["Vieni qui. Piano.", "Così?", "Ancora un passo. Non toccarmi finché non te lo dico."]},
    {"registro": "dopo", "battute": ["Respira.", "Mi hai distrutto.", "E non ho ancora finito."]},
    {"registro": "provocazione", "battute": ["Tutti dicono di saper baciare.", "E tu?", "Io non parlo, provo."]},
    {"registro": "tenerezza sporca", "battute": ["Ti bacio la fronte.", "E poi?", "E poi scendo, che domande."]}
  ]
}
