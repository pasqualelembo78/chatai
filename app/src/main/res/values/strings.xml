    <!-- Commands help -->
    <string name="commands_title">💬 Comandi Chat</string>
    <string name="commands_subtitle">Digita uno di questi comandi nella chat per attivare funzioni speciali.</string>
    <string name="commands_genera_title">🎨 /genera [descrizione]</string>
    <string name="commands_genera_desc">Genera un\'immagine AI fotorealistica usando FLUX.1-schnell.\n\nSe non inserisci una descrizione, viene generato un ritratto del personaggio corrente.\n\n⏱️ Limite: 1 contenuto ogni 10 minuti (condiviso con /muovi).</string>
    <string name="commands_muovi_title">🎬 /muovi [descrizione]</string>
    <string name="commands_muovi_desc">Genera un\'immagine e la anima con SadTalker (via HF Space gratuito).\n\nIl risultato è un breve video con movimento del viso sincronizzato a un audio TTS.\n\n⏱️ Limite: 1 contenuto ogni 10 minuti (condiviso con /genera).</string>
    <string name="commands_esempi_title">✏️ Esempi</string>
    <string name="commands_esempi_desc"><![CDATA[• /genera una ragazza con i capelli rossi al tramonto\n• /genera un gatto nero con occhi verdi\n• /genera (ritratto del personaggio)\n• /muovi un mago che lancia un incantesimo\n• /muovi una principessa che saluta]]></string>
    <string name="commands_note_title">📌 Note</string>
    <string name="commands_note_desc">Immagini e video generati non vengono salvati in cronologia. Sono visibili solo nella conversazione corrente.\n\nIl comando /muovi richiede ~30-60 secondi (elaborazione su GPU condivisa HF).</string>
