<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="database" path="chatai_local.db" />
        <exclude domain="database" path="chatai_local.db-shm" />
        <exclude domain="database" path="chatai_local.db-wal" />
        <exclude domain="sharedpref" path="auth_prefs_encrypted.xml" />
        <exclude domain="sharedpref" path="chatai_prefs.xml" />
        <exclude domain="sharedpref" path="chatai_theme.xml" />
        <exclude domain="file" path="release.keystore" />
        <include domain="file" path="cache/*" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
        <include domain="file" path="." />
        <exclude domain="database" path="chatai_local.db" />
        <exclude domain="database" path="chatai_local.db-shm" />
        <exclude domain="database" path="chatai_local.db-wal" />
        <exclude domain="sharedpref" path="auth_prefs_encrypted.xml" />
        <exclude domain="sharedpref" path="chatai_prefs.xml" />
        <exclude domain="sharedpref" path="chatai_theme.xml" />
        <include domain="file" path="cache/*" />
    </device-transfer>
</data-extraction-rules>