<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp">

            <!-- Header: logo + nome app + claim (riempie lo spazio in alto) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/logo_badge"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/desy"
                    android:scaleType="fitCenter"
                    android:background="@drawable/circle_logo_bg"
                    android:elevation="8dp"
                    android:padding="14dp"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aria"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Il tuo compagno AI"
                android:textSize="15sp"
                android:textColor="@color/on_surface_variant"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="24dp"/>

            <!-- Card login -->
            <LinearLayout
                android:id="@+id/login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:elevation="4dp"
                android:padding="20dp">

                <EditText
                    android:id="@+id/username_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Username"
                    android:textColorHint="@color/on_surface_variant"
                    android:textColor="@color/on_surface"
                    android:inputType="textPersonName"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:background="@drawable/edittext_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/email_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email (opzionale)"
                    android:textColorHint="@color/on_surface_variant"
                    android:textColor="@color/on_surface"
                    android:inputType="textEmailAddress"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:background="@drawable/edittext_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/password_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password (min 8 caratteri)"
                    android:textColorHint="@color/on_surface_variant"
                    android:textColor="@color/on_surface"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:background="@drawable/edittext_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="ACCEDI"
                    android:textSize="14sp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/on_primary"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:cornerRadius="22dp"/>

                <TextView
                    android:id="@+id/toggle_auth_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Non hai account? Registrati"
                    android:textSize="13sp"
                    android:textColor="@color/text_link"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center_horizontal"/>

                <!-- Divider tra gruppo login e gruppo extra -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/outline"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Gruppo extra: referral (collassabile) + bonus -->
                <TextView
                    android:id="@+id/referral_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hai un codice invito?"
                    android:textSize="13sp"
                    android:textColor="@color/text_link"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center_horizontal"/>

                <EditText
                    android:id="@+id/referral_code_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Codice referral (opzionale)"
                    android:textColorHint="@color/on_surface_variant"
                    android:textColor="@color/on_surface"
                    android:inputType="textVisiblePassword"
                    android:maxLength="8"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textSize="13sp"
                    android:background="@drawable/edittext_bg"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/referral_bonus_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inseriscilo qui e ricevi 50 MVC!"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone"/>

                <!-- Config server: nascosto, rivelato con long-press sul logo -->
                <TextView
                    android:id="@+id/server_url_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Configura server..."
                    android:textSize="13sp"
                    android:textColor="@color/text_link"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone"/>

                <EditText
                    android:id="@+id/server_url_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="URL del server (es. http://192.168.1.100:5000)"
                    android:textColorHint="@color/on_surface_variant"
                    android:textColor="@color/on_surface"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:background="@drawable/edittext_bg"
                    android:padding="14dp"
                    android:visibility="gone"/>

                <ProgressBar
                    android:id="@+id/auth_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- Footer legale: colore fisso scuro per leggibilità -->
            <TextView
                android:id="@+id/privacy_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#4A4A4A"
                android:gravity="center"
                android:autoLink="web"
                android:layout_marginTop="16dp"
                android:text="@string/privacy_notice"/>
        </LinearLayout>
    </ScrollView>

</FrameLayout>
