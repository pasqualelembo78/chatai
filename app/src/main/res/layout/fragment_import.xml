<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Importazione"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gestisci l'importazione di personaggi\nda database esterni"
        android:textSize="14sp"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_open_import"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Gestisci Importazione"
        android:textAllCaps="false"
        android:textSize="16sp"
        style="@style/Widget.Aria.Button" />

    <Button
        android:id="@+id/btn_scan_chars"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Scansiona Personaggi"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:layout_marginTop="12dp"
        style="@style/Widget.Aria.Button.Outline" />

    <TextView
        android:id="@+id/chars_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant"
        android:layout_marginTop="12dp" />

</LinearLayout>
