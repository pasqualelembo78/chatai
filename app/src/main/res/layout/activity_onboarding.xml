<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Confetti area -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="✨ 🎉 🌟 🎊 ✨"
            android:textSize="28sp"
            android:gravity="center"
            android:background="@drawable/gradient_background"
            android:layout_marginBottom="24dp"/>

        <!-- Intro text -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vorremmo conoscerti un po' prima del tuo viaggio su ChatAI per suggerirti personaggi che amerai."
            android:textSize="15sp"
            android:textColor="@color/on_surface"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="32dp"/>

        <!-- Gender section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quale genere ti interessa?"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/gender_chip_m"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Maschile"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginRight="6dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/gender_chip_f"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Femminile"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/gender_chip_nb"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Non binario"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginLeft="6dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Age section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fascia d'età (facoltativo)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <Button
                android:id="@+id/age_18_24"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="18-24"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginRight="4dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/age_25_34"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="25-34"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/age_35_44"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="35-44"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/age_45_plus"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="45+"
                android:textSize="13sp"
                android:textColor="@color/on_surface"
                android:backgroundTint="@color/category_chip_bg"
                android:layout_marginLeft="4dp"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Interest tags section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categoria di interesse (facoltativo, max 3)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/interest_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/3 selezionati"
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_anime"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Anime"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_mafia"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Mafia"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_romantico"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Romantico"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_oc"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="OC"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_piccante"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Piccante"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_premuroso"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Premuroso"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_protettivo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Protettivo"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_cattivo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Cattivo"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_realizzato_dai_fan"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Fan made"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_fittizio"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Fittizio"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_amore_proibito"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Amore proibito"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_punto_di_vista_femminile"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="POV femminile"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_atletico"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Atletico"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_musica"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Musica"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_arte"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Arte"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_gaming"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Gaming"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_sport"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Sport"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_cucina"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Cucina"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_viaggi"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Viaggi"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_tecnologia"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Tecnologia"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_moda"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Moda"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_natura"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Natura"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_storia"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Storia"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_scienza"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Scienza"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/tag_mistero"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Mistero"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginRight="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/tag_spiritualita"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Spiritualità"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface"
                    android:backgroundTint="@color/category_chip_bg"
                    android:layout_marginLeft="4dp"
                    android:layout_marginBottom="4dp"
                    android:stateListAnimator="@null"/>

                <Button
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:visibility="invisible"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Confirm button -->
        <Button
            android:id="@+id/btn_onboarding_confirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Entra in ChatAI"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>

</ScrollView>
