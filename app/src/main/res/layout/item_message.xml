<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:gravity="center_vertical">

    <!-- AI Avatar (circular, left side) -->
    <ImageView
        android:id="@+id/message_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Avatar personaggio"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Right side: username + bubble -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Username (hidden by default, shown for user messages) -->
        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_provider"
            android:paddingBottom="2dp"
            android:paddingHorizontal="4dp"
            android:visibility="gone" />

        <!-- Message Bubble -->
        <TextView
            android:id="@+id/message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/chat_text_ai"
            android:padding="14dp"
            android:maxWidth="300dp"
            android:background="@drawable/bubble_ai" />

        <!-- Message Image -->
        <ImageView
            android:id="@+id/message_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="Immagine messaggio"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:background="@drawable/edittext_bg" />

        <!-- Hidden action buttons (shown on long-press via popup menu) -->
        <LinearLayout
            android:id="@+id/action_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_timestamp"
                android:paddingEnd="8dp" />

            <TextView
                android:id="@+id/provider_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="@color/text_provider"
                android:visibility="gone"
                android:paddingEnd="8dp" />

            <ImageButton
                android:id="@+id/play_audio"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Riproduci audio"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:padding="6dp"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_copy_message"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Copia messaggio"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:padding="6dp"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btn_report_message"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_info"
                android:contentDescription="Segnala messaggio"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:visibility="gone"
                android:padding="6dp"
                android:layout_marginStart="4dp"
                app:tint="@android:color/white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
