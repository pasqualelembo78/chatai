# PostgreSQL
DATABASE_URL=postgresql://chatai:chatai_secret@localhost:5432/chatai
POSTGRES_DB=chatai
POSTGRES_USER=chatai
POSTGRES_PASSWORD=chatai_secret
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=

# Master key for encryption
MASTER_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=

# Moderazione contenuti lato server (gating per affinità)
# Soglie sul campo `affinity` della relationship (0-100).
# Oltre SEX_AFFINITY_THRESHOLD tutti i personaggi accettano proposte di sesso.
# Oltre PORN_LANGUAGE_THRESHOLD è consentito il linguaggio pornografico.
# In NSFW_MODE=1 (versione "porno") le soglie diventano 0: contenuto esplicito
# consentito per impostazione predefinita; resta SEMPRE attivo il blocco sui
# minorenni (limite di legge).
NSFW_MODE=0
SEX_AFFINITY_THRESHOLD=60
PORN_LANGUAGE_THRESHOLD=85

